# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database

# App Configuration
APP_NAME=RegattaResume
BASE_URL=http://localhost:5000

# Scraper Configuration
SCRAPER_ENABLED=true
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; RegattaResume/1.0)

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_PDF_EXPORT=true

# Email (profile-claim verification)
# With ENABLE_EMAIL=false, verification links are logged instead of sent,
# so local development needs no SMTP server.
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=noreply@regattaresume.com

# Require a verified email before a shareable resume link can be created.
# Claiming a profile stays immediate either way.
REQUIRE_VERIFIED_EMAIL_TO_PUBLISH=true
EMAIL_VERIFY_TOKEN_MAX_AGE_HOURS=48
